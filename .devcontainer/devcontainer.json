// VS Code: "Reopen in Container" (Dev Containers extension). Python, the libraries and JupyterLab
// come from the Docker image of this repository; nothing to install on the computer but Docker.
// The repository is mounted on /work, where monalisa is installed in editable mode: changes to
// src/ apply at the next import. Images show in notebooks with sliders (view="inline"); for napari
// windows on Linux, choose the "Linux display" configuration instead. See docs/docker.md.
{
  "name": "monalisa-python",
  "build": { "dockerfile": "../Dockerfile", "context": ".." },
  "workspaceMount": "source=${localWorkspaceFolder},target=/work,type=bind",
  "workspaceFolder": "/work",
  "remoteUser": "monalisa",
  // A .venv of the repository (made outside the container, e.g. on macOS or Windows) would be
  // picked by VS Code instead of the image's Python, and cannot run in the container: hide it.
  "mounts": ["source=monalisa-venv-${devcontainerId},target=/work/.venv,type=volume"],
  // git for VS Code's source control (not in the image, which is for running monalisa)
  "features": { "ghcr.io/devcontainers/features/git:1": { "version": "os-provided", "ppa": false } },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter", "charliermarsh.ruff"],
      "settings": { "python.defaultInterpreterPath": "/usr/local/bin/python" }
    }
  }
}
